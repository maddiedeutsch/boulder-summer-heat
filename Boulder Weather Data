    "## 1. Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "8a8b9215-576a-4d24-aead-43a99c6cf532",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import time\n",
    "from datetime import date\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import requests\n",
    "\n",
    "# Boulder, Colorado\n",
    "LATITUDE = 40.015\n",
    "LONGITUDE = -105.2705\n",
    "FIRST_YEAR = 1980\n",
    "LAST_YEAR = 2025\n",
    "\n",
    "API_URL = \"https://archive-api.open-meteo.com/v1/archive\"\n",
    "\n",
    "HEADERS = {'User-Agent': 'WebDatScience/1.0 (dure6372@colorado.edu)'}\n",
    "PAUSE_SECONDS = 1\n",
    "\n",
    "RAW_DIR = Path(\"data/raw\")\n",
    "RAW_DIR.mkdir(parents=True, exist_ok=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1283f05b-249b-44ff-b77b-0a27b3303ba5",
   "metadata": {},
   "source": [
    "## 2. Collect the raw data\n",
    "\n",
    "One request per summer (46 requests total). Each response is saved as its own JSON file in data/raw/. If a file already exists, that summer is skipped, so re-running the notebook does not send the same requests again."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "178426b2-5fcd-45c7-a30e-d11de2afc5f3",
   "metadata": {},
   "outputs": [
    {
