     ]
    }
   ],
   "source": [
    "requests_sent = 0\n",
    "\n",
    "for year in range(FIRST_YEAR, LAST_YEAR + 1):\n",
    "    out_file = RAW_DIR / f\"summer_{year}.json\"\n",
    "    if out_file.exists():\n",
    "        print(f\"{year}: already saved, skipping\")\n",
    "        continue\n",
    "\n",
    "    params = {\n",
    "        \"latitude\": LATITUDE,\n",
    "        \"longitude\": LONGITUDE,\n",
    "        \"start_date\": f\"{year}-06-01\",\n",
    "        \"end_date\": f\"{year}-08-31\",\n",
    "        \"daily\": \"temperature_2m_max\",\n",
    "        \"temperature_unit\": \"fahrenheit\",\n",
    "        \"timezone\": \"America/Denver\",\n",
    "    }\n",
    "    response = requests.get(API_URL, params=params, headers=HEADERS, timeout=30)\n",
    "    response.raise_for_status()\n",
    "\n",
    "    out_file.write_text(json.dumps(response.json()))\n",
    "    requests_sent += 1\n",
    "    print(f\"{year}: saved {len(response.json()['daily']['time'])} days\")\n",
    "\n",
    "    time.sleep(PAUSE_SECONDS)\n",
    "\n",
    "print(f\"\\nRequests sent this run: {requests_sent}\")\n",
    "print(f\"Collected on: {date.today()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e6c95d22-da1c-4c99-a31b-d3b5cd4d63e0",
   "metadata": {},
   "source": [
    "## 3. Clean the data\n",
    "\n",
    "Steps:\n",
    "\n",
    "Load every raw JSON file and check the units are °F.  \n",
    "Combine them into one table with one row per day.  \n",
    "Convert dates, add year and month columns.  \n",
    "Check for missing values and duplicate dates, and drop any.  \n",
    "Keep only June to August, round temperatures to 1 decimal, and flag 90°F+ days."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "82732de2-0991-423a-9d7d-4d73cae05b56",
   "metadata": {},
   "outputs": [],
   "source": [
    "frames = []\n",
    "for path in sorted(RAW_DIR.glob(\"summer_*.json\")):\n",
    "    raw = json.loads(path.read_text())\n",
    "    unit = raw[\"daily_units\"][\"temperature_2m_max\"]\n",
    "    assert unit == \"°F\", f\"{path.name} is in {unit}, not °F\"\n",
    "    frames.append(pd.DataFrame({\n",
    "        \"date\": raw[\"daily\"][\"time\"],\n",
    "        \"temp_max_f\": raw[\"daily\"][\"temperature_2m_max\"],\n",
    "    }))\n",
    "\n",
    "df = pd.concat(frames, ignore_index=True)\n",
    "print(\"Rows before cleaning:\", len(df))\n",
    "\n",
    "df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
    "print(\"Missing temperatures:\", df[\"temp_max_f\"].isna().sum())\n",
    "print(\"Duplicate dates:\", df[\"date\"].duplicated().sum())\n",
    "\n",
    "df = df.dropna(subset=[\"temp_max_f\"]).drop_duplicates(subset=\"date\")\n",
    "df = df[df[\"date\"].dt.month.isin([6, 7, 8])]\n",
    "\n",
    "df[\"year\"] = df[\"date\"].dt.year\n",
    "df[\"month\"] = df[\"date\"].dt.month\n",
    "df[\"temp_max_f\"] = df[\"temp_max_f\"].round(1)\n",
    "df[\"hot_day\"] = df[\"temp_max_f\"] >= 90\n",
    "\n",
    "df = df[[\"date\", \"year\", \"month\", \"temp_max_f\", \"hot_day\"]].sort_values(\"date\").reset_index(drop=True)\n",
    "\n",
    "print(\"Rows after cleaning:\", len(df))\n",
    "print(\"Summers:\", df[\"year\"].nunique())\n",
    "print(\"Days per summer (should all be 92):\", df.groupby(\"year\").size().unique())\n",
    "df.head(10)"
   ]
  },
